# Server-only: URL do backend NestJS usada pelos Route Handlers (src/app/api/**)
# e Server Components (via src/lib/server/api.ts) para chamadas servidor-servidor.
# Nunca é exposta ao browser. Sem essa variável, o build falha explicitamente
# (ver src/lib/env.ts) em vez de tentar bater em um localhost inexistente em produção.
API_INTERNAL_URL=http://localhost:3001

# Pública: URL do backend usada no browser para montar links diretos a arquivos
# estáticos servidos pelo Nest (/uploads/*), como fotos de projeto e avatar.
# Ver src/lib/asset-url.ts.
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:3001
